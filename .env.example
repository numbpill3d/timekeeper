# --- Database ---
POSTGRES_USER=omniscient
POSTGRES_PASSWORD=changeme
POSTGRES_DB=omniscient
DATABASE_URL=postgresql://omniscient:changeme@timescaledb:5432/omniscient

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- LLM ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral
OPENAI_API_KEY=
# fallback if ollama is unavailable

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENVIRONMENT=development
# Development-only placeholder. Replace with `openssl rand -hex 32` before use.
JWT_SECRET=local-development-secret-change-me-please-123456
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Local time interpretation ---
# IANA zone used for "today", alert windows, and evidence answer formatting.
TIMEZONE=UTC

# --- CORS ---
# Comma-separated list of explicit allowed origins. Wildcards are rejected
# because the API uses credentialed requests.
ALLOWED_ORIGINS=http://localhost:3000

# --- Notifications ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=

# --- Storage ---
MEDIA_BUCKET=omniscient-media
S3_ENDPOINT_URL=http://minio:9000     # swap for real S3 in prod
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000 # browser-reachable endpoint
# Local Docker defaults only; replace both values before production use.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CLIP_URL_TTL_SECONDS=300
DEFAULT_RETENTION_DAYS=30
RETENTION_INTERVAL_SECONDS=3600

# --- Cloud camera adapters (optional; keep tokens out of the database) ---
RING_ACCESS_TOKEN=
RING_ACCESS_TOKEN_FILE=
RING_REFRESH_TOKEN=
RING_REFRESH_TOKEN_FILE=
RING_TOKEN_URL=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
NEST_ACCESS_TOKEN=
NEST_ACCESS_TOKEN_FILE=
NEST_REFRESH_TOKEN=
NEST_REFRESH_TOKEN_FILE=
NEST_TOKEN_URL=
NEST_CLIENT_ID=
NEST_CLIENT_SECRET=
NEST_PROJECT_ID=
ARLO_ACCESS_TOKEN=
ARLO_ACCESS_TOKEN_FILE=
ARLO_REFRESH_TOKEN=
ARLO_REFRESH_TOKEN_FILE=
ARLO_TOKEN_URL=
ARLO_CLIENT_ID=
ARLO_CLIENT_SECRET=
WYZE_ACCESS_TOKEN=
WYZE_ACCESS_TOKEN_FILE=
WYZE_REFRESH_TOKEN=
WYZE_REFRESH_TOKEN_FILE=
WYZE_TOKEN_URL=
WYZE_CLIENT_ID=
WYZE_CLIENT_SECRET=
# For production secret stores, set e.g. RING_ACCESS_TOKEN_FILE=/run/secrets/ring_token.
# *_ACCESS_TOKEN_FILE values are read by ingestion and never stored in the database.
# Optional provider-specific WHEP endpoint templates, using {device_id}.
RING_WHEP_URL_TEMPLATE=
ARLO_WHEP_URL_TEMPLATE=
WYZE_WHEP_URL_TEMPLATE=
# --- Services (internal URLs) ---
QUERY_ENGINE_URL=http://query-engine:8001

# --- Pipedream Connect ---
# Production Connect project. Keep the OAuth client secret in the deployment
# secret store; never commit it or expose it to the web bundle.
PIPEDREAM_PROJECT_ID=proj_LosKaGy
PIPEDREAM_ENVIRONMENT=production
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
# Optional absolute URL to return to after the hosted Connect flow completes.
PIPEDREAM_SUCCESS_REDIRECT_URI=
